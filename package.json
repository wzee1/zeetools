{
  "name": "zeetools",
  "version": "0.0.0",
  "private": true,
  "description": "The free zee tools (zeepass, zeeimage, zeecall) and @zeetools/ui, the app shell and component library they share.",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:ct": "pnpm -r --if-present run test:ct",
    "build": "pnpm -r --if-present run build",
    "tools:refresh": "node --env-file-if-exists=.env.local scripts/refresh-tools.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7"
  }
}
