{
  "name": "zeetools",
  "version": "0.0.0",
  "private": true,
  "description": "The free zee tools (zeepass, zeeimage, zeecall) and @zeetools/ui, the app shell and component library they share.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ct": "npm run test:ct --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7"
  }
}
