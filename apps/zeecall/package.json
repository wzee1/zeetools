{
  "name": "zeecall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "deploy": "pnpm build && wrangler pages deploy out --project-name zeecall --branch main && node ../../scripts/refresh-hub.mjs call",
    "deploy:signaling": "wrangler deploy -c worker/wrangler.jsonc",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zeetools/ui": "workspace:*",
    "lucide-react": "1.60.0",
    "motion": "14.4.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.152.0"
  }
}
