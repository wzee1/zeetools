{
  "name": "@zeetools/ui",
  "version": "0.1.0",
  "description": "The zee app shell and component library: a resizable sidebar, tokens, motion, commands and the UI primitives of the zee tools. Ships TypeScript source for Next.js and Tailwind v4.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzee1/zeetools.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/wzee1/zeetools/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/wzee1/zeetools/issues"
  },
  "keywords": [
    "nextjs",
    "react",
    "tailwindcss",
    "ui",
    "app-shell",
    "design-system"
  ],
  "exports": {
    "./styles/tokens.css": "./styles/tokens.css",
    "./components/commands/group-commands": "./src/components/commands/group-commands.ts",
    "./components/icons/variants": "./src/components/icons/variants.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ct": "cypress run --component",
    "test:ct:open": "cypress open --component",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "cmdk": "^1.1.1",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "cmdk": "1.1.1",
    "cypress": "16.1.1",
    "cypress-real-events": "1.15.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "jsdom": "29.1.1",
    "lucide-react": "1.60.0",
    "motion": "14.4.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "storybook": "10.6.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
